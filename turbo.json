{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "out/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    }
  },
  "globalEnv": [
    "DATABASE_URL",
    "DATABASE_URL_DIRECT",
    "JWT_SECRET",
    "JWT_EXPIRES_IN",
    "ENCRYPTION_KEY",
    "TOTP_ISSUER",
    "OPEN_FINANCE_SANDBOX_BASE_URL",
    "OPEN_FINANCE_WEBHOOK_SECRET",
    "WEB_ORIGIN",
    "API_PORT",
    "NEXT_PUBLIC_API_BASE",
    "NODE_ENV"
  ]
}
