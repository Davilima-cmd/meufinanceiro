{
  "name": "meufinanceiro",
  "version": "0.0.0",
  "private": true,
  "description": "Aplicativo financeiro para casal: web, Android e API",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json,css}\" \"packages/**/*.{ts,tsx,json}\" \"*.{json,mjs,yaml,yml}\" \".github/**/*.yml\" README.md docs/architecture.md docs/security.md",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,json,css}\" \"packages/**/*.{ts,tsx,json}\" \"*.{json,mjs,yaml,yml}\" \".github/**/*.yml\" README.md docs/architecture.md docs/security.md",
    "docker-up": "docker compose up --build -d",
    "docker-down": "docker compose down",
    "docker-logs": "docker compose logs -f",
    "docker-clean": "docker compose down -v --remove-orphans"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.50.0",
    "vitest": "^5.1.0"
  }
}
