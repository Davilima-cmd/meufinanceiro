generator client {
  provider      = "prisma-client-js"
  // "native" cobre o ambiente de desenvolvimento; a Vercel (Amazon Linux 2023)
  // precisa do alvo rhel-openssl-3.0.x, senão o runtime não encontra o engine.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_DIRECT")
}

model User {
  id        String    @id @default(cuid()) @db.VarChar(255)
  name      String    @db.VarChar(255)
  email     String    @unique @db.VarChar(255)
  password  String    @db.VarChar(255)
  totpSecret String?   @db.VarChar(255)
  mfaEnabled Boolean  @default(false)
  theme     String    @default("system") @db.VarChar(32)
  currency  String    @default("BRL") @db.VarChar(16)
  hideValues Boolean  @default(false) @map("hide_values")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  sessions        Session[]
  partnershipsAsOwner    Partnership[] @relation("PartnershipOwner")
  partnershipsAsPartner  Partnership[] @relation("PartnershipPartner")
  accountSharesOwned     AccountShare[] @relation("AccountShareOwner")
  accountSharesReceived  AccountShare[] @relation("AccountShareSharedWith")
  financialAccounts   FinancialAccount[]
  transactions        Transaction[]
  bankConnections     BankConnection[]
  consents            Consent[]
  categories          Category[]
  budgets             Budget[]
  financialGoals      FinancialGoal[]
  syncJobs            SyncJob[]
  auditLogs           AuditLog[]
  passwordResets      PasswordReset[]
  allocations         Allocation[]
  recurrences         Recurrence[]
  netWorthItems       NetWorthItem[]

  @@map("users")
}

/// Pedido de redefinição de senha. O token só é guardado como hash, expira em
/// 30 minutos e é de uso único (`usedAt`), conforme regra de segurança do item 26.2.
model PasswordReset {
  id        String    @id @default(cuid()) @db.VarChar(255)
  userId    String    @db.VarChar(255)
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model Session {
  id        String   @id @default(cuid()) @db.VarChar(255)
  userId    String   @db.VarChar(255)
  tokenHash String   @db.VarChar(255)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@index([userId])
}

model Partnership {
  id        String   @id @default(cuid()) @db.VarChar(255)
  userId    String   @db.VarChar(255)
  partnerId String   @db.VarChar(255)
  status    String   @default("pending") @db.VarChar(32) // pending, accepted, revoked
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User @relation("PartnershipOwner", fields: [userId], references: [id], onDelete: Cascade)
  partner  User @relation("PartnershipPartner", fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("partnerships")
  @@index([userId])
  @@index([partnerId])
  @@unique([userId, partnerId])
}

model AccountShare {
  id        String   @id @default(cuid()) @db.VarChar(255)
  accountId String   @db.VarChar(255)
  userId    String   @db.VarChar(255) // dono da conta
  sharedWithId String @db.VarChar(255) // parceiro com acesso
  level     String   @default("BALANCE_ONLY") @db.VarChar(32) // BALANCE_ONLY | FULL
  createdAt DateTime @default(now())
  revokedAt DateTime?

  account   FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner     User             @relation("AccountShareOwner", fields: [userId], references: [id], onDelete: Cascade)
  sharedWith User            @relation("AccountShareSharedWith", fields: [sharedWithId], references: [id], onDelete: Cascade)

  @@map("account_shares")
  @@index([accountId])
  @@index([sharedWithId])
  @@unique([accountId, sharedWithId])
}

model FinancialAccount {
  id          String   @id @default(cuid()) @db.VarChar(255)
  userId      String   @db.VarChar(255)
  name        String   @db.VarChar(255)
  institution String?  @db.VarChar(255)
  type        String   @default("manual") @db.VarChar(32) // manual, checking, savings, investment
  currency    String   @default("BRL") @db.VarChar(16)
  balanceCents Decimal  @default(0) @db.Decimal(20, 0)
  isActive    Boolean  @default(true)
  /// Exclusão lógica: a conta sai das telas e dos totais, mas o histórico
  /// continua no banco (registro financeiro não se apaga sem deixar rastro).
  deletedAt   DateTime?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shares     AccountShare[]
  connections BankConnection[]
  transactions Transaction[]
  recurrences  Recurrence[]

  @@map("financial_accounts")
  @@index([userId])
  @@index([deletedAt])
}

model BankConnection {
  id             String   @id @default(cuid()) @db.VarChar(255)
  userId         String   @db.VarChar(255)
  accountId      String   @db.VarChar(255)
  provider       String   @db.VarChar(128)
  providerAccountId String @db.VarChar(255)
  status         String   @default("active") @db.VarChar(32) // active, awaiting_authorization, expired, error, disconnected
  consentId      String?  @db.VarChar(255)
  expiresAt      DateTime?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("bank_connections")
  @@index([userId])
  @@index([accountId])
  @@unique([provider, providerAccountId])
}

model Consent {
  id          String   @id @default(cuid()) @db.VarChar(255)
  userId      String   @db.VarChar(255)
  provider    String   @db.VarChar(128)
  externalId  String   @db.VarChar(255)
  status      String   @default("active") @db.VarChar(32)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("consents")
  @@index([userId])
}

/// Modelo de lançamento recorrente (aluguel, assinatura, salário).
///
/// O modelo não é o lançamento: ele descreve "todo mês, nesse dia, esse valor".
/// Uma rotina gera os lançamentos do mês corrente até `nextRunAt`, sempre com
/// `status: 'pending'` — recorrente é conta a pagar/receber até alguém liquidar.
model Recurrence {
  id           String   @id @default(cuid()) @db.VarChar(255)
  userId       String   @db.VarChar(255)
  accountId    String   @db.VarChar(255)
  categoryId   String?  @db.VarChar(255)
  description  String   @db.VarChar(255)
  /// Valor em centavos, com sinal (negativo = despesa), como nos lançamentos.
  amountCents  Decimal  @db.Decimal(20, 0)
  type         String   @db.VarChar(16)
  /// `monthly` por enquanto; `weekly`/`yearly` entram sem migração nova.
  frequency    String   @default("monthly") @db.VarChar(16)
  /// Dia do mês (1–28) em que o lançamento é criado.
  dayOfMonth   Int      @default(1)
  /// Último dia já gerado: evita duplicar ao rodar a rotina duas vezes.
  nextRunAt    DateTime
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  FinancialAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("recurrences")
  @@index([userId])
  @@index([nextRunAt])
}

/// Rateio de um lançamento entre duas pessoas do casal.
///
/// Cada linha é a parte de **um** participante. A soma das partes é sempre
/// exatamente o valor do lançamento: a diferença de arredondamento é distribuída
/// em centavos nas primeiras partes, nunca "sumindo".
model Allocation {
  id            String   @id @default(cuid()) @db.VarChar(255)
  transactionId String   @db.VarChar(255)
  /// Quem deve esta parte (pode ser o próprio dono do lançamento).
  userId        String   @db.VarChar(255)
  /// Parte em centavos, sempre positiva: o rateio divide o valor absoluto.
  shareCents    Decimal  @db.Decimal(20, 0)
  /// `equal` ou `proportional`, para o histórico mostrar como foi dividido.
  mode          String   @db.VarChar(16)
  /// Peso/percentual usado no modo proporcional (nulo no igualitário).
  percentBasis  Float?
  settledAt     DateTime?
  createdAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("allocations")
  @@unique([transactionId, userId])
  @@index([userId])
}

model Transaction {
  id           String   @id @default(cuid()) @db.VarChar(255)
  accountId    String   @db.VarChar(255)
  userId       String   @db.VarChar(255)
  categoryId   String?
  description  String   @db.VarChar(255)
  amountCents  Decimal  @db.Decimal(20, 0) // centavos, negativo para despesa
  type         String   @db.VarChar(16) // income, expense, transfer
  origin       String   @default("manual") @db.VarChar(32) // manual, imported
  providerId   String?  @db.VarChar(255) // id original do provedor (idempotência)
  /// Par que liga as duas pontas de uma transferência (débito na origem e crédito no destino).
  transferId   String?  @db.VarChar(255)
  /// Data de caixa: quando o dinheiro efetivamente entrou ou saiu.
  date         DateTime
  /// Data de competência: a que mês o lançamento pertence (regime de competência).
  competenceDate DateTime @default(now())
  /// pending (a pagar/receber), paid (liquidado), canceled (anulado sem efeito).
  status       String   @default("pending") @db.VarChar(16)
  /// Momento da liquidação; nulo enquanto `status` for `pending`.
  paidAt       DateTime?
  /// Vencimento, para contas a pagar/receber.
  dueDate      DateTime?
  /// Exclusão lógica: o lançamento some das listas e dos totais, mas o
  /// registro permanece auditável (e o saldo já foi estornado na exclusão).
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  allocations Allocation[]

  @@map("transactions")
  @@index([userId])
  @@index([deletedAt])
  @@index([accountId])
  @@index([date])
  @@index([competenceDate])
  @@index([status])
  @@index([transferId])
  @@unique([providerId])
}

model Category {
  id          String   @id @default(cuid()) @db.VarChar(255)
  userId      String?  // null = categoria inicial compartilhada do sistema
  name        String   @db.VarChar(128)
  color       String   @default("#246b61") @db.VarChar(16)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  user       User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets Budget[]
  recurrences Recurrence[]

  @@map("categories")
  @@index([userId])
}

model Budget {
  id          String   @id @default(cuid()) @db.VarChar(255)
  userId      String   @db.VarChar(255)
  categoryId  String   @db.VarChar(255)
  amountCents Decimal  @db.Decimal(20, 0)
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("budgets")
  @@index([userId])
}

model FinancialGoal {
  id          String   @id @default(cuid()) @db.VarChar(255)
  userId      String   @db.VarChar(255)
  name        String   @db.VarChar(255)
  targetCents Decimal  @db.Decimal(20, 0)
  currentCents Decimal @default(0) @db.Decimal(20, 0)
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@map("financial_goals")
  @@index([userId])
}

/// Item de patrimônio declarado à mão: bem (carro, imóvel) ou dívida
/// (financiamento, empréstimo).
///
/// Contas financeiras já entram no patrimônio pelo saldo; isto cobre o que não
/// é conta — e o que **tira** patrimônio, que é a dívida. Sem o passivo, o
/// "quanto eu tenho" da tela vira ficção.
model NetWorthItem {
  id          String   @id @default(cuid()) @db.VarChar(255)
  userId      String   @db.VarChar(255)
  name        String   @db.VarChar(128)
  /// `asset` (bem) ou `liability` (dívida).
  kind        String   @db.VarChar(16)
  /// Sempre positivo: o sinal vem do `kind`, não do número.
  valueCents  Decimal  @db.Decimal(20, 0)
  note        String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("net_worth_items")
  @@index([userId])
}

/// Histórico de aportes de uma meta.
///
/// Antes o progresso era um número solto (`currentCents`) que alguém editava à
/// mão: não dava para saber quando entrou, quanto entrou nem voltar atrás. Cada
/// aporte é uma linha; `currentCents` passa a ser a soma deles.
model GoalContribution {
  id          String   @id @default(cuid()) @db.VarChar(255)
  goalId      String   @db.VarChar(255)
  /// Pode ser negativo: resgate da meta.
  amountCents Decimal  @db.Decimal(20, 0)
  note        String?  @db.VarChar(255)
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  goal FinancialGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@map("goal_contributions")
  @@index([goalId, occurredAt])
}

model WebhookEvent {
  id          String   @id @default(cuid()) @db.VarChar(255)
  provider    String   @db.VarChar(128)
  eventId     String   @unique @db.VarChar(255)
  payload     Json
  processed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("webhook_events")
  @@index([processed])
}

model SyncJob {
  id          String   @id @default(cuid()) @db.VarChar(255)
  userId      String   @db.VarChar(255)
  status      String   @default("pending") @db.VarChar(32) // pending, completed, failed
  startedAt   DateTime?
  finishedAt  DateTime?
  error       String?  @db.Text
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sync_jobs")
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid()) @db.VarChar(255)
  userId    String?
  action    String   @db.VarChar(128)
  target    String?  @db.VarChar(255)
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
  @@index([userId])
  @@index([createdAt])
}
