# Meu Financeiro API - Environment Variables Example
# Copy this file to apps/api/.env and fill in your values
# NEVER commit .env files with real values!

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
# Direct connection URL (for migrations)
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/meufinanceiro

# Pooler connection URL (for application - uses connection pooling)
DATABASE_POOLER_URL=postgresql://USUARIO:SENHA@HOST:5432/meufinanceiro?pgbouncer=true

# =============================================================================
# AUTHENTICATION
# =============================================================================
JWT_SECRET=seu_jwt_secret_aqui_gerado_com_openssl_rand_base64_32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001
LOG_LEVEL=debug

# =============================================================================
# OPEN FINANCE (Fase 4 — sandbox)
# =============================================================================
OPEN_FINANCE_SANDBOX_BASE_URL=https://sandbox.openfinance.example.com

# =============================================================================
# SEGURANÇA (Fase 5)
# =============================================================================
# Chave para criptografia de campos sensíveis (AES-256-GCM). Gere um valor real
# com: openssl rand -hex 32. Este é apenas um exemplo — nunca use em produção
# e nunca commite o valor real no Git.
ENCRYPTION_KEY=exemplo_de_chave_de_criptografia_hex_64_caracteres_nao_use_em_producao

# Emissor (issuer) exibido nos apps autenticadores para tokens TOTP (MFA).
TOTP_ISSUER="Meu Financeiro"

# =============================================================================
# OBSERVABILIDADE E LIMITES (opcionais)
# =============================================================================
# Sem DSN o Sentry fica desligado: nada é enviado e nenhum ambiente depende de
# conta externa. Cookies, Authorization e X-CSRF-Token são removidos do evento.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.05

# Limite global de requisições por IP (padrão 120/minuto).
# RATE_LIMIT_PER_MINUTE=120

# Swagger em produção: desligado por padrão (o mapa da API é superfície de
# ataque). Ligue apenas em ambiente controlado.
# ENABLE_API_DOCS=false
