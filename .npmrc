# pnpm configuration for monorepo with Expo
# node-linker=hoisted is required for Expo to find native modules correctly
# in a pnpm monorepo because Expo's Metro bundler doesn't support PnP
node-linker=hoisted

# Use symlinks for better compatibility
package-import-method=clone

# Enable strict peer dependency resolution
strict-peer-dependencies=false

# Auto-install peer dependencies
auto-install-peers=true