# Copie para .env para desenvolvimento local. Valores reais nunca vão para o Git.
NODE_ENV=development
API_PORT=3001

# Origens permitidas no CORS (separadas por vírgula). Em produção é obrigatório.
WEB_ORIGIN=http://localhost:3000

# URL da API exposta ao navegador (usada na build da web).
NEXT_PUBLIC_API_BASE=http://localhost:3001/api

# Banco de dados PostgreSQL (porta 5432 local; serviço `db` no Docker Compose).
# Em producao (Azure) use sslmode=require e connection_limit por causa do
# limite de conexoes do plano gratuito.
DB_PASSWORD=postgres
DATABASE_URL="postgres://postgres:***@localhost:5432/meufinanceiro"
DATABASE_URL_DIRECT="postgres://postgres:***@localhost:5432/meufinanceiro"

# Segredo de assinatura do JWT. Em desenvolvimento aceita o valor de exemplo;
# em producao precisa ter no minimo 32 caracteres: openssl rand -base64 48
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=1h

# =============================================================================
# OPEN FINANCE — conexão bancária real (Pluggy, agregador regulado)
# =============================================================================
# Credenciais do aplicativo no dashboard do Pluggy (Dashboard → Aplicações).
# Ficam SÓ no servidor: são elas que trocam por API key (2 h) e pelo token do
# widget de consentimento (30 min). Com estas duas variáveis definidas a API usa
# o provedor real; sem elas cai no sandbox (fora de produção).
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Opcional: sobrescreve a URL base (homologação do provedor).
# PLUGGY_BASE_URL=https://api.pluggy.ai
# Opcional: o provedor avisa esta URL quando o item é sincronizado. Use o domínio
# público da API (ex.: https://meufinanceiro-api-xxx.vercel.app/api/open-finance/webhooks/pluggy).
OPEN_FINANCE_WEBHOOK_URL=
# Libera o sandbox fictício mesmo em produção. Só para homologação: com
# credenciais reais configuradas, mantenha desligado.
# OPEN_FINANCE_SANDBOX_IN_PRODUCTION=false

# URL base do sandbox do provedor Open Finance (apenas fora de produção).
OPEN_FINANCE_SANDBOX_BASE_URL=https://sandbox.openfinance.example.com

# Segredo compartilhado com o provedor para assinar webhooks (HMAC-SHA256).
# Em producao, sem este valor a API rejeita todos os webhooks.
OPEN_FINANCE_WEBHOOK_SECRET=

# Segredo do cron de tarefas periódicas (`/api/cron/daily`): gera as
# recorrências vencidas e reconcilia os bancos conectados. Sem ele a rota
# responde 404. Gere com `openssl rand -hex 32` e cadastre o MESMO valor no
# cron da Vercel (que envia `Authorization: Bearer $CRON_SECRET`).
CRON_SECRET=

# =============================================================================
# SEGURANÇA (Fase 5)
# =============================================================================
# Chave para criptografia de campos sensíveis (AES-256-GCM). Precisa de
# EXATAMENTE 32 bytes em base64: gere com `openssl rand -base64 32` (não use
# `-hex 32`, que produz 48 bytes e faz a API recusar a inicialização).
ENCRYPTION_KEY=Y2hhdmUtZGUtZXhlbXBsby0zMi1ieXRlcy16enp6eno=

# Emissor (issuer) exibido nos apps autenticadores para tokens TOTP (MFA).
TOTP_ISSUER="Meu Financeiro"
