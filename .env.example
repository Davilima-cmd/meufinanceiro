# Copie para .env para desenvolvimento local. Valores reais nunca vão para o Git.
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:3001/api

# Banco de dados PostgreSQL (porta 5432 local; serviço `db` no Docker Compose).
# Exemplo de formato (edite antes de usar): postgres://postgres:SENHA @localhost:5432/meufinanceiro
#   -> remova o espaço antes de @ e defina a senha real ao copiar para .env
DB_PASSWORD=postgres
DATABASE_URL="postgres://postgres:SENHA @localhost:5432/meufinanceiro"
DATABASE_URL_DIRECT="postgres://postgres:SENHA @localhost:5432/meufinanceiro"

JWT_SECRET=dev-secret-change-me

# =============================================================================
# OPEN FINANCE (Fase 4 — sandbox do provedor de agregação)
# =============================================================================
# URL base do sandbox do provedor Open Finance. Apenas dados fictícios/sandbox;
# nunca credenciais bancárias reais. Ajuste conforme a documentação do provedor.
OPEN_FINANCE_SANDBOX_BASE_URL=https://sandbox.openfinance.example.com

# =============================================================================
# SEGURANÇA (Fase 5)
# =============================================================================
# Chave para criptografia de campos sensíveis (AES-256-GCM). Gere um valor real
# com: openssl rand -hex 32. Este é apenas um exemplo — nunca use em produção
# e nunca commite o valor real no Git.
ENCRYPTION_KEY=exemplo_de_chave_de_criptografia_hex_64_caracteres_nao_use_em_producao

# Emissor (issuer) exibido nos apps autenticadores para tokens TOTP (MFA).
TOTP_ISSUER=Meu Financeiro
