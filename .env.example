# Copy to .env for local development. Keep real values out of Git.
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# Configure only when the database phase begins. Use separate direct and pooler URLs.
DATABASE_URL=
DATABASE_URL_DIRECT=

# Gerar um valor forte antes de usar em produção.
JWT_SECRET=dev-secret-change-me
