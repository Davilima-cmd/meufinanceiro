# Meu Financeiro - Environment Variables Example
# Copy this file to .env and fill in your values
# NEVER commit .env files with real values!

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
# Direct connection URL (for migrations)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:Caju13032306.@db.lowevmopfcwafuzfcvqr.supabase.co:5432/postgres

# Pooler connection URL (for application - uses connection pooling)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true
DATABASE_POOLER_URL=postgresql://postgres:Caju13032306.@db.lowevmopfcwafuzfcvqr.supabase.co:5432/postgres?pgbouncer=true

# =============================================================================
# AUTHENTICATION
# =============================================================================
# JWT secret for signing tokens (generate with: openssl rand -base64 32)
JWT_SECRET=seu_jwt_secret_aqui_gerado_com_openssl_rand_base64_32

# JWT expiration
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# OPEN FINANCE (Brazil Open Finance)
# =============================================================================
# Client ID from Open Finance registration
OPEN_FINANCE_CLIENT_ID=seu_client_id_aqui

# Client secret from Open Finance registration
OPEN_FINANCE_CLIENT_SECRET=seu_client_secret_aqui

# Certificate path for mTLS
OPEN_FINANCE_CERT_PATH=./certs/client.pem

# Certificate key path for mTLS
OPEN_FINANCE_KEY_PATH=./certs/client.key

# =============================================================================
# EXTERNAL APIs
# =============================================================================
# API keys for external services (example)
EXTERNAL_API_KEY=sua_chave_api_externa_aqui

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Application port
PORT=3000

# Node environment
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3010

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=debug